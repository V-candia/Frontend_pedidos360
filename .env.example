# "dev" = token del emisor OAuth2 local (sin MSAL). "azure" = MSAL real.
VITE_AUTH_MODE=dev

# API Gateway / backend (el navegador llama desde el host, por eso localhost)
VITE_API_BASE_URL=http://localhost:8090
VITE_DEV_TOKEN_URL=http://localhost:8080/default/token

# Solo modo azure: App Registration "Pedidos360"
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_API_SCOPE=api://<API_CLIENT_ID>/.default
